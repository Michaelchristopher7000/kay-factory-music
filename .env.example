# ---------------------------------------------------------------
# Kay Factory Music — Security
# ---------------------------------------------------------------
KFM_LOGIN_MAX_ATTEMPTS=5
KFM_LOGIN_IP_MAX_ATTEMPTS=20
KFM_LOGIN_DECAY_SECONDS=900

KFM_PASSWORD_MIN_LENGTH=12
KFM_PASSWORD_MIXED_CASE=true
KFM_PASSWORD_NUMBERS=true
KFM_PASSWORD_SYMBOLS=true
KFM_PASSWORD_CHECK_COMPROMISED=false

# ---------------------------------------------------------------
# Kay Factory Music — Two-Factor Authentication
# ---------------------------------------------------------------
KFM_2FA_CHALLENGE_TTL_SECONDS=300
KFM_2FA_MAX_VERIFY_ATTEMPTS=5
KFM_2FA_IP_MAX_ATTEMPTS=10
KFM_2FA_DECAY_SECONDS=900
KFM_2FA_RECOVERY_CODE_COUNT=8

# ---------------------------------------------------------------
# Kay Factory Music — Frontend Session Timeout
# ---------------------------------------------------------------
VITE_KFM_SESSION_IDLE_WARNING_MINUTES=25
VITE_KFM_SESSION_IDLE_LOGOUT_MINUTES=30

# ---------------------------------------------------------------
# Production Security Settings
# ---------------------------------------------------------------

# Session cookie "secure" flag.
# MUST be false for local HTTP (XAMPP).
# MUST be true in production (HTTPS) — otherwise the flag is silently ignored.
SESSION_SECURE_COOKIE=false

# SameSite attribute for session cookies.
# 'lax' is the correct value for a same-site SPA.
SESSION_SAME_SITE=lax

# Trusted proxies (comma-separated IPs or CIDR ranges).
# Leave EMPTY for local dev.
# Set this in production ONLY if your app runs behind a load balancer,
# reverse proxy (Nginx), or CDN (Cloudflare).
# Example: TRUSTED_PROXIES=192.168.1.1,10.0.0.0/8
TRUSTED_PROXIES=